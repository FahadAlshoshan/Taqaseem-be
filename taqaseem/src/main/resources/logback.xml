<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATH" value="/home/dev/taqaseem_logs"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{dd-MM-yyyy HH:mm:ss.SSS} ~ %-5level ~ %thread ~ %class{0} ~ %method ~ %msg%n"/>

    <!-- Appender to log to console-->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/taqaseem_debug.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>
                ${CONSOLE_LOG_PATTERN}
            </Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/taqaseem_debug.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>5</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Root logger set to WARN to suppress Spring noise -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Your application at DEBUG level -->
    <logger name="com.app.taqaseem" level="DEBUG"/>

    <!-- Enable Spring Web logging for request/response details -->
    <logger name="org.springframework.web" level="DEBUG"/>

    <!-- Enable detailed request logging -->
    <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping" level="TRACE"/>

    <!-- Log HTTP requests/responses -->
    <logger name="org.springframework.web.servlet.DispatcherServlet" level="DEBUG"/>

</configuration>